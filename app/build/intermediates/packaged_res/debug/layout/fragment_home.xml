<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Top Header: Search Bar + Cloud + VIP Crown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <!-- Search input bar -->
            <LinearLayout
                android:id="@+id/btn_search_bar"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search_hint" />

                <EditText
                    android:id="@+id/et_search_home"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />
            </LinearLayout>

            <!-- Cloud Sync Icon -->
            <ImageView
                android:id="@+id/btn_cloud_home"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="7dp"
                android:src="@drawable/ic_cloud"
                android:contentDescription="@string/get_benefits" />

            <!-- VIP Crown Icon -->
            <ImageView
                android:id="@+id/btn_vip_home"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="7dp"
                android:src="@drawable/ic_crown"
                android:contentDescription="@string/item_vip_upgrade" />
        </LinearLayout>

        <!-- Quick Action Row: 5 items evenly distributed across the screen -->
        <LinearLayout
            android:id="@+id/grid_home_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Item 1: Quét -->
            <LinearLayout
                android:id="@+id/btn_action_scan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:paddingHorizontal="2dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_action_scan">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_scan" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="6dp"
                    android:text="@string/action_scan"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:gravity="center_horizontal"
                    android:lines="2" />
            </LinearLayout>

            <!-- Item 2: Công cụ PDF -->
            <LinearLayout
                android:id="@+id/btn_action_pdf_tools"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:paddingHorizontal="2dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_action_pdf">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_pdf" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="6dp"
                    android:text="@string/action_pdf_tools"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:gravity="center_horizontal"
                    android:lines="2" />
            </LinearLayout>

            <!-- Item 3: Nhập ảnh -->
            <LinearLayout
                android:id="@+id/btn_action_import_image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:paddingHorizontal="2dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_action_image">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_image" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="6dp"
                    android:text="@string/action_import_image"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:gravity="center_horizontal"
                    android:lines="2" />
            </LinearLayout>

            <!-- Item 4: Nhập tập tin -->
            <LinearLayout
                android:id="@+id/btn_action_import_file"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:paddingHorizontal="2dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_action_file">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_file" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="6dp"
                    android:text="@string/action_import_file"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:gravity="center_horizontal"
                    android:lines="2" />
            </LinearLayout>

            <!-- Item 5: Trích xuất văn bản -->
            <LinearLayout
                android:id="@+id/btn_action_ocr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:paddingHorizontal="2dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_action_ocr">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_ocr" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="6dp"
                    android:text="@string/action_ocr"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:gravity="center_horizontal"
                    android:lines="2" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section: Gần đây (Recent) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/recent_header"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_see_all_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_all"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Empty State Card (Exact replica of Screenshot 1) -->
        <LinearLayout
            android:id="@+id/layout_empty_recent"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_card_rounded"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Empty Document Graphic with True Dashed Border -->
            <FrameLayout
                android:layout_width="92dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_dashed_document_border"
                android:padding="7dp">

                <!-- White Paper Sheet -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_document_paper"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="16dp"
                    android:paddingHorizontal="10dp">

                    <!-- Line 1: Header line -->
                    <View
                        android:layout_width="34dp"
                        android:layout_height="2.5dp"
                        android:background="#4A7C77" />

                    <!-- Line 2 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2.5dp"
                        android:layout_marginTop="10dp"
                        android:background="#4A7C77" />

                    <!-- Line 3 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2.5dp"
                        android:layout_marginTop="10dp"
                        android:background="#4A7C77" />

                    <!-- Line 4 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2.5dp"
                        android:layout_marginTop="10dp"
                        android:background="#4A7C77" />

                    <!-- Line 5: Short footer line -->
                    <View
                        android:layout_width="36dp"
                        android:layout_height="2.5dp"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="start"
                        android:background="#3D5A56" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/no_recent_files"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_scan_new_document"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_outline_teal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:text="@string/scan_new_document"
                android:textColor="@color/primary_teal"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Populated Recent Documents RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recent_docs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
