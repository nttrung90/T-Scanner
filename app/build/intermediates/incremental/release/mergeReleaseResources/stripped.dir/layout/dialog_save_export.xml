<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:minWidth="320dp"
    android:padding="22dp"
    android:background="@drawable/bg_card_rounded">

    <!-- Header with Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_dialog_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_folder"
            app:tint="@color/primary_teal" />

        <TextView
            android:id="@+id/tv_save_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/convert_success"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_save_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tập tin đã được chuyển đổi thành công. Vui lòng chọn thư mục để lưu:"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- File Name Input (Visible for single file, hidden if multiple files) -->
    <LinearLayout
        android:id="@+id/layout_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/et_save_file_name"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_search_bar"
            android:hint="@string/file_name_hint"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:paddingHorizontal="14dp"
            android:textSize="14sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Multi-file Summary Info (Visible if multiple files) -->
    <TextView
        android:id="@+id/tv_files_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_bar"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Primary Action: Chọn thư mục lưu... -->
    <LinearLayout
        android:id="@+id/btn_choose_save_folder"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/btn_solid_teal"
        android:gravity="center"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_folder"
            app:tint="@color/bg_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_save_folder"
            android:textColor="@color/bg_dark"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Secondary Action: Lưu vào Tải về (Downloads) -->
    <LinearLayout
        android:id="@+id/btn_save_to_downloads"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_outline_teal"
        android:gravity="center"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save_to_downloads"
            android:textColor="@color/primary_teal"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Actions: Chia sẻ & Hủy/Đóng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_share_export"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="@string/share"
            android:textColor="@color/primary_teal"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_cancel_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="@string/cancel"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
