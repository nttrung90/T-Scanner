<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Flag Emoji -->
    <TextView
        android:id="@+id/tv_lang_flag"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="20sp"
        tools:text="🇻🇳" />

    <!-- Text & Badge container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_lang_native_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Tiếng Việt" />

            <!-- Engine Badge -->
            <TextView
                android:id="@+id/tv_engine_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_search_bar"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/primary_teal"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Tesseract OCR" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_lang_sub_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Tiếng Việt (vi)" />
    </LinearLayout>

    <!-- Selected Checkmark -->
    <ImageView
        android:id="@+id/iv_lang_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/primary_teal"
        android:visibility="gone"
        tools:visibility="visible"
        android:contentDescription="@null" />

</LinearLayout>
