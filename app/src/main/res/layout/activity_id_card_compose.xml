<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <LinearLayout
        android:id="@+id/layout_compose_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/bg_dark_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back_compose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary"
            android:contentDescription="@string/btn_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_compose_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/id_card_composer_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_compose_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/id_card_a4_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_save_compose"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_solid_teal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/save"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Center Canvas Preview Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_a4_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="4dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true">

            <ImageView
                android:id="@+id/iv_a4_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@string/id_card_a4_preview_desc" />
        </androidx.cardview.widget.CardView>

        <ProgressBar
            android:id="@+id/pb_compose_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary_teal"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Controls Panel -->
    <LinearLayout
        android:id="@+id/layout_bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark_header"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <!-- Selector Row 1: Bố cục -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:text="@string/id_card_section_layout"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_layout_portrait"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:text="@string/id_card_layout_portrait"
                android:textColor="@color/primary_teal"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tab_layout_landscape"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="@string/id_card_layout_landscape"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tab_layout_single"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="0.8"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="@string/id_card_layout_single"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Selector Row 2: Tỉ lệ & Viền -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:text="@string/id_card_section_scale"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_scale_actual"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:text="@string/id_card_scale_actual"
                android:textColor="@color/primary_teal"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tab_scale_fit"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:text="@string/id_card_scale_fit"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_toggle_border"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="0.8"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:text="@string/id_card_border_toggle"
                android:textColor="@color/primary_teal"
                android:textSize="11sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider_dark" />

        <!-- Quick Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Đổi 2 mặt -->
            <LinearLayout
                android:id="@+id/btn_swap_sides"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_reset"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/id_card_swap_sides"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Cắt Mặt trước -->
            <LinearLayout
                android:id="@+id/btn_crop_front"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_crop"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/id_card_crop_front"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Cắt Mặt sau -->
            <LinearLayout
                android:id="@+id/btn_crop_back"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_crop"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/id_card_crop_back"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- In ấn -->
            <LinearLayout
                android:id="@+id/btn_print_a4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_print"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/id_card_print"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Nút VIP Bỏ đóng dấu -->
            <LinearLayout
                android:id="@+id/btn_vip_watermark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_vip_watermark_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_crown"
                    app:tint="@color/vip_gold" />

                <TextView
                    android:id="@+id/tv_vip_watermark_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/id_card_remove_watermark_vip"
                    android:textColor="@color/vip_gold"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
