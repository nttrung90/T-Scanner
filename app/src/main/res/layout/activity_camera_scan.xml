<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CameraX Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Focus & Document Guide Overlay -->
    <com.tscanner.app.ui.camera.FocusOverlayView
        android:id="@+id/focusOverlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Flash effect on shutter capture -->
    <View
        android:id="@+id/vShutterFlash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Bar Toolbar -->
    <LinearLayout
        android:id="@+id/layoutCameraTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Close Button -->
        <ImageButton
            android:id="@+id/btnCloseCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_camera_pill"
            android:src="@drawable/ic_close"
            android:contentDescription="Đóng"
            app:tint="#FFFFFF" />

        <!-- Flash Button -->
        <ImageButton
            android:id="@+id/btnFlashToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_camera_pill"
            android:src="@drawable/ic_flash_off"
            android:contentDescription="Đèn flash"
            app:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Auto-Crop Toggle Pill -->
        <LinearLayout
            android:id="@+id/btnAutoCropToggle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_camera_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/ivAutoCropIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_auto_crop"
                app:tint="#00C28E" />

            <TextView
                android:id="@+id/tvAutoCropLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Tự căn viền"
                android:textColor="#00C28E"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Switch to AI Scan Mode (Google ML Kit) -->
        <LinearLayout
            android:id="@+id/btnSwitchAiScan"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_camera_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_magic_wand"
                app:tint="#FFD54F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Quét AI"
                android:textColor="#FFD54F"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Guide Hint Label -->
    <TextView
        android:id="@+id/tvCameraHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_camera_pill"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="⚡ Chạm màn hình để lấy nét • Căn văn bản vào khung"
        android:textColor="#DDFFFFFF"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/layoutCameraTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Controls Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCameraBottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left: Last Captured Thumbnail Preview -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLastThumbnail"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:visibility="invisible"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#222329"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnShutterCapture"
            app:layout_constraintBottom_toBottomOf="@id/btnShutterCapture">

            <ImageView
                android:id="@+id/ivLastThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <!-- Center: Super-fast Shutter Button -->
        <ImageButton
            android:id="@+id/btnShutterCapture"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_shutter_button"
            android:contentDescription="Chụp ảnh siêu tốc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Right: Done Button with Page Badge -->
        <FrameLayout
            android:id="@+id/layoutDoneContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnShutterCapture"
            app:layout_constraintBottom_toBottomOf="@id/btnShutterCapture">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDoneScan"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Hoàn tất"
                android:textColor="#131418"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#00C28E"
                app:cornerRadius="24dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp" />

            <!-- Page Count Badge -->
            <TextView
                android:id="@+id/tvDonePageCount"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-4dp"
                android:layout_marginEnd="-4dp"
                android:background="@drawable/bg_camera_badge"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
