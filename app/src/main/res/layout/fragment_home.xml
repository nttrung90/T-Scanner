<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Top Header: Search Bar + Cloud + VIP Crown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <!-- Search input bar -->
            <LinearLayout
                android:id="@+id/btn_search_bar"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search_hint" />

                <EditText
                    android:id="@+id/et_search_home"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />
            </LinearLayout>

            <!-- VIP / Free Badge Button -->
            <FrameLayout
                android:id="@+id/btn_vip_home"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="48dp"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/vip_home_desc_free">

                <ImageView
                    android:id="@+id/iv_vip_home_badge"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:padding="6dp"
                    android:src="@drawable/ic_vip"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_free_home_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/bg_card_rounded"
                    android:text="@string/vip_badge_free"
                    android:textColor="@color/primary_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:importantForAccessibility="no"
                    android:visibility="visible" />
            </FrameLayout>
        </LinearLayout>

        <!-- Quick Action Grid: 2 rows of 4 items with compact spacing -->
        <LinearLayout
            android:id="@+id/grid_home_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <!-- Row 1: Quét, Quét thẻ, Quét QR, Công cụ PDF -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="2dp">

                <!-- Item 1: Quét -->
                <LinearLayout
                    android:id="@+id/btn_action_scan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="2dp"
                    android:paddingHorizontal="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_action_scan">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_scan" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="28dp"
                        android:layout_marginTop="3dp"
                        android:text="@string/action_scan"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:gravity="center_horizontal|top"
                        android:lines="2" />
                </LinearLayout>

                <!-- Item 2: Quét thẻ -->
                <LinearLayout
                    android:id="@+id/btn_action_id_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="2dp"
                    android:paddingHorizontal="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_action_idcard">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_id_card" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="28dp"
                        android:layout_marginTop="3dp"
                        android:text="@string/action_id_card"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:gravity="center_horizontal|top"
                        android:lines="2" />
                </LinearLayout>

                <!-- Item 3: Quét QR (Bên cạnh Quét thẻ) -->
                <LinearLayout
                    android:id="@+id/btn_action_qr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="2dp"
                    android:paddingHorizontal="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_action_qr">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_qr_code" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="28dp"
                        android:layout_marginTop="3dp"
                        android:text="@string/action_qr_scan"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:gravity="center_horizontal|top"
                        android:lines="2" />
                </LinearLayout>

                <!-- Item 4: Công cụ PDF -->
                <LinearLayout
                    android:id="@+id/btn_action_pdf_tools"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="2dp"
                    android:paddingHorizontal="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_action_pdf">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_pdf" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="28dp"
                        android:layout_marginTop="3dp"
                        android:text="@string/action_pdf_tools"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:gravity="center_horizontal|top"
                        android:lines="2" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Nhập ảnh, Nhập tập tin, Trích xuất văn bản, Tạo file PDF -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Item 5: Nhập ảnh -->
                <LinearLayout
                    android:id="@+id/btn_action_import_image"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="2dp"
                    android:paddingHorizontal="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_action_image">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_image" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="28dp"
                        android:layout_marginTop="3dp"
                        android:text="@string/action_import_image"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:gravity="center_horizontal|top"
                        android:lines="2" />
                </LinearLayout>

                <!-- Item 6: Nhập tập tin -->
                <LinearLayout
                    android:id="@+id/btn_action_import_file"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="2dp"
                    android:paddingHorizontal="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_action_file">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_file" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="28dp"
                        android:layout_marginTop="3dp"
                        android:text="@string/action_import_file"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:gravity="center_horizontal|top"
                        android:lines="2" />
                </LinearLayout>

                <!-- Item 7: Trích xuất văn bản -->
                <LinearLayout
                    android:id="@+id/btn_action_ocr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="2dp"
                    android:paddingHorizontal="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_action_ocr">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_ocr" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="28dp"
                        android:layout_marginTop="3dp"
                        android:text="@string/action_ocr"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:gravity="center_horizontal|top"
                        android:lines="2" />
                </LinearLayout>

                <!-- Item 8: Tất cả -->
                <LinearLayout
                    android:id="@+id/btn_action_all_tools"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="2dp"
                    android:paddingHorizontal="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/action_all_tools">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_action_circle">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tab_tools" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="28dp"
                        android:layout_marginTop="3dp"
                        android:text="@string/action_all_tools"
                        android:textColor="@color/text_primary"
                        android:textSize="11.5sp"
                        android:gravity="center_horizontal|top"
                        android:lines="2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <!-- Section: Bản nháp chưa lưu (Active Draft Banner - B04) -->
        <LinearLayout
            android:id="@+id/layout_active_draft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_action_circle">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_scan"
                    app:tint="@color/primary_teal"
                    android:contentDescription="@string/draft_resume_title" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tv_draft_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/draft_resume_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_draft_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_resume_draft"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/draft_resume_btn"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:paddingHorizontal="14dp"
                app:cornerRadius="18dp"
                android:backgroundTint="@color/primary_teal"
                android:textColor="@color/text_primary"
                app:elevation="0dp" />

            <ImageView
                android:id="@+id/btn_discard_active_draft"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete" />
        </LinearLayout>

        <!-- Section: Gần đây (Recent) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/recent_header"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_see_all_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_all"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Empty State Card (Exact replica of Screenshot 1) -->
        <LinearLayout
            android:id="@+id/layout_empty_recent"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_card_rounded"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Empty Document Graphic with True Dashed Border -->
            <FrameLayout
                android:layout_width="92dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_dashed_document_border"
                android:padding="7dp">

                <!-- White Paper Sheet -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_document_paper"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="16dp"
                    android:paddingHorizontal="10dp">

                    <!-- Line 1: Header line -->
                    <View
                        android:layout_width="34dp"
                        android:layout_height="2.5dp"
                        android:background="#4A7C77" />

                    <!-- Line 2 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2.5dp"
                        android:layout_marginTop="10dp"
                        android:background="#4A7C77" />

                    <!-- Line 3 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2.5dp"
                        android:layout_marginTop="10dp"
                        android:background="#4A7C77" />

                    <!-- Line 4 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2.5dp"
                        android:layout_marginTop="10dp"
                        android:background="#4A7C77" />

                    <!-- Line 5: Short footer line -->
                    <View
                        android:layout_width="36dp"
                        android:layout_height="2.5dp"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="start"
                        android:background="#3D5A56" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/no_recent_files"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_scan_new_document"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_outline_teal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:text="@string/scan_new_document"
                android:textColor="@color/primary_teal"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Populated Recent Documents RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recent_docs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
