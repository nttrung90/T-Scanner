<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <LinearLayout
        android:id="@+id/layout_editor_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/bg_dark_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back_editor"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="7dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            app:tint="@color/text_primary"
            android:contentDescription="@string/close" />

        <TextView
            android:id="@+id/tv_editor_doc_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Tài liệu mới"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_preview_doc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_solid_teal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/btn_preview"
            android:textColor="@color/bg_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Center Workspace: ZoomableImageView + CropOverlayView + Floating Compare Button -->
    <FrameLayout
        android:id="@+id/layout_editor_workspace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A0B0E">

        <com.tscanner.app.ui.editor.view.ZoomableImageView
            android:id="@+id/iv_editor_target"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Ảnh trang hiện tại" />

        <com.tscanner.app.ui.editor.CropOverlayView
            android:id="@+id/crop_overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Floating Compare Button ("Xem ảnh ban đầu" - nhấn giữ để đối chiếu) -->
        <LinearLayout
            android:id="@+id/btn_compare_initial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="14dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="#B31A1B22"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_compare"
                app:tint="@color/text_primary"
                android:contentDescription="@string/view_initial_image" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/view_initial_image"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_editor_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary_teal"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Page Indicator & Thumbnail Strip -->
    <LinearLayout
        android:id="@+id/layout_page_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark_header"
        android:orientation="vertical"
        android:paddingVertical="6dp"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tv_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Trang 1 / 3" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_editor_thumbnails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_post_scan_thumbnail" />
    </LinearLayout>

    <!-- Tool Customization Panel (Bảng tùy chỉnh trượt) -->
    <LinearLayout
        android:id="@+id/layout_customization_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- 1. Panel: Bộ lọc -->
        <LinearLayout
            android:id="@+id/panel_filter_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_filter_original"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:background="@drawable/btn_solid_teal"
                android:text="@string/filter_original"
                android:textColor="@color/bg_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_filter_grayscale"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:background="@drawable/btn_outline_teal"
                android:text="@string/filter_grayscale"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_filter_black_white"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/btn_outline_teal"
                android:text="@string/filter_black_white"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 2. Panel: Tăng nét -->
        <LinearLayout
            android:id="@+id/panel_enhance_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sharpness_level"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sharpness_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_teal"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="0" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_sharpness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/primary_teal"
                android:thumbTint="@color/primary_teal" />
        </LinearLayout>

        <!-- 3. Panel: Cắt và xoay -->
        <LinearLayout
            android:id="@+id/panel_crop_rotate_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/btn_rotate_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_rotate_left"
                    app:tint="@color/text_primary"
                    android:contentDescription="@string/rotate_left" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/rotate_left"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_rotate_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_rotate_right"
                    app:tint="@color/text_primary"
                    android:contentDescription="@string/rotate_right" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/rotate_right"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_reset_crop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_reset"
                    app:tint="@color/text_primary"
                    android:contentDescription="Đặt lại" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Đặt lại"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Panel: Làm sạch (Giảm bóng & Làm sáng nền) -->
        <LinearLayout
            android:id="@+id/panel_clean_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Giảm bóng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/shadow_reduction"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_shadow_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="0" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_shadow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/primary_teal"
                android:thumbTint="@color/primary_teal" />

            <!-- Làm sáng nền -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/background_lighten"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_lighten_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_teal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="0" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_lighten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/primary_teal"
                android:thumbTint="@color/primary_teal" />
        </LinearLayout>

        <!-- Customization Panel Footer Actions: Hoàn tác | Tất cả trang | Áp dụng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_undo_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_undo"
                android:drawablePadding="4dp"
                android:drawableTint="@color/text_secondary"
                android:text="@string/undo_page"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="6dp"
                android:paddingHorizontal="8dp" />

            <CheckBox
                android:id="@+id/cb_apply_all_pages"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/apply_all_pages"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:buttonTint="@color/primary_teal" />

            <TextView
                android:id="@+id/btn_apply_tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_solid_teal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:text="@string/apply_changes"
                android:textColor="@color/bg_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Toolbar: 4 Tools with icon top, label bottom -->
    <LinearLayout
        android:id="@+id/layout_editor_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:background="@color/bg_dark_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <!-- Tool 1: Bộ lọc -->
        <LinearLayout
            android:id="@+id/btn_tool_filter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iv_tool_filter"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_filter"
                app:tint="@color/text_secondary"
                android:contentDescription="@string/tool_filter" />

            <TextView
                android:id="@+id/tv_tool_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tool_filter"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tool_filter_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tool_filter_desc"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Tool 2: Tăng nét -->
        <LinearLayout
            android:id="@+id/btn_tool_enhance"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iv_tool_enhance"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sharpen"
                app:tint="@color/text_secondary"
                android:contentDescription="@string/tool_enhance" />

            <TextView
                android:id="@+id/tv_tool_enhance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tool_enhance"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tool_enhance_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tool_enhance_desc"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Tool 3: Cắt và xoay -->
        <LinearLayout
            android:id="@+id/btn_tool_crop_rotate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iv_tool_crop_rotate"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_crop"
                app:tint="@color/text_secondary"
                android:contentDescription="@string/tool_crop_rotate" />

            <TextView
                android:id="@+id/tv_tool_crop_rotate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tool_crop_rotate"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tool_crop_rotate_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tool_crop_rotate_desc"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Tool 4: Làm sạch -->
        <LinearLayout
            android:id="@+id/btn_tool_clean"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iv_tool_clean"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_clean"
                app:tint="@color/text_secondary"
                android:contentDescription="@string/tool_clean" />

            <TextView
                android:id="@+id/tv_tool_clean"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tool_clean"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tool_clean_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tool_clean_desc"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
